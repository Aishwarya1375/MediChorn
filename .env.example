# Required server-side environment variables:
# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/medichron)
MONGODB_URI=

# GEMINI_API_KEY: Required for Gemini AI API calls. AI Studio automatically injects this.
GEMINI_API_KEY=

# EMAIL_API_KEY: Transactional email service API key (e.g. Resend or SendGrid)
EMAIL_API_KEY=

# EMAIL_FROM: Verified sender email address (e.g. onboarding@resend.dev)
EMAIL_FROM=

# AUTH_SECRET: JWT secret key for signing authenticated session tokens
AUTH_SECRET=
